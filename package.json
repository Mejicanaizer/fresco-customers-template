{
  "name": "fresco-customers-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node --experimental-strip-types --env-file-if-exists=.env server/start.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "test:local-owner": "node --experimental-strip-types --env-file-if-exists=.env tests/local-owner-check.ts",
    "test:hosted-owner": "node --experimental-strip-types tests/hosted-owner-check.ts",
    "qa:local-owner": "node --experimental-strip-types --env-file-if-exists=.env tests/local-owner-qa.ts",
    "qa:hosted-owner": "node --experimental-strip-types tests/hosted-owner-qa.ts",
    "test:local-browser": "playwright test --config=playwright.live.config.ts",
    "storefront": "node --experimental-strip-types scripts/storefront-deploy.ts",
    "test:deno": "node --experimental-strip-types tests/deno-runtime-check.ts"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}

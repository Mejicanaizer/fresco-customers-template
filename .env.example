# Private server configuration. No VITE_ secret settings.
# Copy to .env and replace with this deployment's exact site and owner endpoint.
STOREFRONT_SITE_ID=
STOREFRONT_OWNER_API_ORIGIN=
STOREFRONT_PUBLIC_ORIGIN=http://127.0.0.1:5373
# Required in production; deployment-scoped opaque token issued by the owner API.
STOREFRONT_OWNER_API_TOKEN=
PORT=5373
HOST=127.0.0.1
